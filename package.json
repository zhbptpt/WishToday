{
  "name": "wishtoday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "npm run build -- --base=/WishToday/ && node scripts/prepare-spa-fallback.mjs",
    "preview": "vite preview",
    "probe:supabase-auth": "node scripts/supabase/auth-capability-probe.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test scripts/deployment-config.check.mjs scripts/render-config.check.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.3",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
